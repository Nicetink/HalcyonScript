# HalcyonScript Audio Player
# A simple music player with play/pause/stop controls

HalGUI.init()
HalGUI.setTheme("dark")

# Create main window
create window app "Audio Player" 520 400

# Title
create label lblTitle "HalcyonScript Audio Player" x:20 y:15 width:480 height:30

# Current file label
create label lblFile "No file loaded" x:20 y:50 width:480 height:25

# Time display
create label lblTime "00:00 / 00:00" x:20 y:80 width:480 height:25

# Progress slider
create slider sliderProgress x:20 y:115 width:480 height:30 min:0 max:100

# Control buttons
create button btnOpen "Open" x:20 y:160 width:90 height:40
create button btnPlay "Play" x:120 y:160 width:80 height:40
create button btnPause "Pause" x:210 y:160 width:80 height:40
create button btnStop "Stop" x:300 y:160 width:80 height:40
create button btnAbout "About" x:390 y:160 width:80 height:40

# Volume controls
create label lblVolume "Volume:" x:20 y:220 width:70 height:25
create slider sliderVolume x:90 y:220 width:300 height:30 min:0 max:100
create label lblVolVal "100%" x:400 y:220 width:80 height:25

# Theme selector
create label lblTheme "Theme:" x:20 y:270 width:70 height:25
create button btnDark "Dark" x:90 y:270 width:80 height:30
create button btnLight "Light" x:180 y:270 width:80 height:30
create button btnMidnight "Midnight" x:270 y:270 width:90 height:30
create button btnOcean "Ocean" x:370 y:270 width:80 height:30

# Status
create label lblStatus "Ready" x:20 y:315 width:480 height:25

# Loop checkbox
create checkbox chkLoop "Loop" x:20 y:350 width:100 height:25

# Variables
var currentFile = ""
var isPlaying = false

# Create audio player
Audio.create("player")

# Open file button
when btnOpen clicked {
    var file = HalGUI.openFile("Select Audio", "Audio|*.mp3;*.wav||")
    if file != null {
        currentFile = file
        set lblFile.text = file
        Audio.load("player", file)
        set lblStatus.text = "Loaded"
    }
}

# Play button
when btnPlay clicked {
    if currentFile != "" {
        var state = Audio.getState("player")
        if state == "paused" {
            Audio.resume("player")
        } else {
            Audio.play("player")
        }
        set lblStatus.text = "Playing..."
    } else {
        set lblStatus.text = "No file!"
    }
}

# Pause button
when btnPause clicked {
    Audio.pause("player")
    set lblStatus.text = "Paused"
}

# Stop button
when btnStop clicked {
    Audio.stop("player")
    set lblStatus.text = "Stopped"
    set sliderProgress.value = 0
}

# Progress slider - seek when changed (temporarily disabled due to parser limitation)
# when sliderProgress changed {
#     get sliderProgress.value -> progress
#     var duration = Audio.getDuration("player")
#     var position = (progress * duration) / 100
#     Audio.seek("player", position)
# }

# Volume slider
when sliderVolume changed {
    get sliderVolume.value -> vol
    Audio.setVolume("player", vol)
    set lblVolVal.text = str(vol) + "%"
}

# Loop checkbox
when chkLoop clicked {
    get chkLoop.checked -> loop
    Audio.setLoop("player", loop)
    if loop {
        set lblStatus.text = "Loop ON"
    } else {
        set lblStatus.text = "Loop OFF"
    }
}

# Theme buttons
when btnDark clicked {
    HalGUI.setTheme("dark")
    set lblStatus.text = "Theme: Dark"
}

when btnLight clicked {
    HalGUI.setTheme("light")
    set lblStatus.text = "Theme: Light"
}

when btnMidnight clicked {
    HalGUI.setTheme("midnight")
    set lblStatus.text = "Theme: Midnight"
}

when btnOcean clicked {
    HalGUI.setTheme("ocean")
    set lblStatus.text = "Theme: Ocean"
}

# About button
when btnAbout clicked {
    HalGUI.messageBox("About Audio Player", "HalcyonScript Audio Player v1.0\n\nA modern audio player built with HalGUI\n\nFeatures:\n- MP3, WAV, WMA support\n- Real-time theme switching\n- Volume control\n- Loop mode\n- Seek functionality\n\nBuilt with HalcyonScript", 0, 0)
}

# Set initial volume
set sliderVolume.value = 100

# Start GUI
HalGUI.run()
