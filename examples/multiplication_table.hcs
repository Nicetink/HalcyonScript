// Таблица умножения
print "=== Multiplication Table ==="
var input_str = input("Enter number (1-20): ")
var n = int(input_str)

print ""
print "Multiplication table for", n, ":"
print "------------------------"
for i from 1 to 10 {
    var result = n * i
    print n, "x", i, "=", result
}
print "------------------------"
