# HalForms Contacts - Contact management application
# Uses HalForms Windows Forms-like API

print "Starting Contacts Manager..."

# Initialize HalForms
HalForms.init()

# Create main form
HalForms.createForm("mainForm", "Contacts Manager", 700, 550, 0)

# Search section
HalForms.createControl("label", "searchLabel", "Search:", 10, 10, 50, 25)
HalForms.createControl("textbox", "searchInput", "", 65, 10, 200, 25)
HalForms.createControl("button", "searchBtn", "Search", 275, 10, 70, 25)
HalForms.createControl("button", "clearSearchBtn", "Clear", 350, 10, 60, 25)

# Contact list
HalForms.createControl("listbox", "contactList", "", 10, 45, 250, 400)

# Contact details panel
HalForms.createControl("label", "detailsLabel", "Contact Details", 280, 45, 150, 25)

HalForms.createControl("label", "nameLabel", "Name:", 280, 80, 80, 25)
HalForms.createControl("textbox", "nameInput", "", 365, 80, 200, 25)

HalForms.createControl("label", "phoneLabel", "Phone:", 280, 115, 80, 25)
HalForms.createControl("textbox", "phoneInput", "", 365, 115, 200, 25)

HalForms.createControl("label", "emailLabel", "Email:", 280, 150, 80, 25)
HalForms.createControl("textbox", "emailInput", "", 365, 150, 200, 25)

HalForms.createControl("label", "addressLabel", "Address:", 280, 185, 80, 25)
HalForms.createControl("textbox", "addressInput", "", 365, 185, 200, 60)
HalForms.setProperty("addressInput", "multiline", true)

HalForms.createControl("label", "notesLabel", "Notes:", 280, 255, 80, 25)
HalForms.createControl("textbox", "notesInput", "", 365, 255, 200, 80)
HalForms.setProperty("notesInput", "multiline", true)

# Action buttons
HalForms.createControl("button", "newBtn", "New", 280, 350, 80, 30)
HalForms.createControl("button", "saveBtn", "Save", 370, 350, 80, 30)
HalForms.createControl("button", "deleteBtn", "Delete", 460, 350, 80, 30)

# Import/Export buttons
HalForms.createControl("button", "importBtn", "Import", 280, 390, 80, 30)
HalForms.createControl("button", "exportBtn", "Export", 370, 390, 80, 30)

# Status bar
HalForms.createStatusBar("statusBar", 2)
HalForms.setStatusBarText("statusBar", 0, "Ready")
HalForms.setStatusBarText("statusBar", 1, "Contacts: 0")

# Contact storage (arrays for each field)
global contactNames = []
global contactPhones = []
global contactEmails = []
global contactAddresses = []
global contactNotes = []
global currentIndex = -1

# Function to update contact count
func updateContactCount() {
    HalForms.setStatusBarText("statusBar", 1, "Contacts: " + str(len(contactNames)))
}

# Function to refresh contact list
func refreshContactList() {
    HalForms.clearItems("contactList")
    for i from 0 to len(contactNames) - 1 {
        HalForms.addItem("contactList", contactNames[i])
    }
    updateContactCount()
}

# Function to clear form
func clearForm() {
    HalForms.setProperty("nameInput", "text", "")
    HalForms.setProperty("phoneInput", "text", "")
    HalForms.setProperty("emailInput", "text", "")
    HalForms.setProperty("addressInput", "text", "")
    HalForms.setProperty("notesInput", "text", "")
    currentIndex = -1
}

# Function to load contact into form
func loadContact(index) {
    if index < 0 or index >= len(contactNames) {
        return
    }
    
    HalForms.setProperty("nameInput", "text", contactNames[index])
    HalForms.setProperty("phoneInput", "text", contactPhones[index])
    HalForms.setProperty("emailInput", "text", contactEmails[index])
    HalForms.setProperty("addressInput", "text", contactAddresses[index])
    HalForms.setProperty("notesInput", "text", contactNotes[index])
    currentIndex = index
    
    HalForms.setStatusBarText("statusBar", 0, "Loaded: " + contactNames[index])
}

# Function to save contact
func saveContact() {
    global name = HalForms.getProperty("nameInput", "text")
    if name == "" {
        HalForms.messageBox("Name is required!", "Warning", 0, 0)
        return
    }
    
    global phone = HalForms.getProperty("phoneInput", "text")
    global email = HalForms.getProperty("emailInput", "text")
    global address = HalForms.getProperty("addressInput", "text")
    global notes = HalForms.getProperty("notesInput", "text")
    
    if currentIndex >= 0 {
        # Update existing contact
        contactNames[currentIndex] = name
        contactPhones[currentIndex] = phone
        contactEmails[currentIndex] = email
        contactAddresses[currentIndex] = address
        contactNotes[currentIndex] = notes
        HalForms.setStatusBarText("statusBar", 0, "Updated: " + name)
    } else {
        # Add new contact
        contactNames.push(name)
        contactPhones.push(phone)
        contactEmails.push(email)
        contactAddresses.push(address)
        contactNotes.push(notes)
        currentIndex = len(contactNames) - 1
        HalForms.setStatusBarText("statusBar", 0, "Added: " + name)
    }
    
    refreshContactList()
}

# Function to delete contact
func deleteContact() {
    if currentIndex < 0 {
        HalForms.messageBox("Please select a contact!", "Warning", 0, 0)
        return
    }
    
    global name = contactNames[currentIndex]
    global confirm = HalForms.messageBox("Delete contact: " + name + "?", "Confirm", 4, 0)
    
    if confirm == 6 {
        # Remove from all arrays
        global newNames = []
        global newPhones = []
        global newEmails = []
        global newAddresses = []
        global newNotes = []
        
        for i from 0 to len(contactNames) - 1 {
            if i != currentIndex {
                newNames.push(contactNames[i])
                newPhones.push(contactPhones[i])
                newEmails.push(contactEmails[i])
                newAddresses.push(contactAddresses[i])
                newNotes.push(contactNotes[i])
            }
        }
        
        contactNames = newNames
        contactPhones = newPhones
        contactEmails = newEmails
        contactAddresses = newAddresses
        contactNotes = newNotes
        
        clearForm()
        refreshContactList()
        HalForms.setStatusBarText("statusBar", 0, "Deleted: " + name)
    }
}

# Function to search contacts
func searchContacts() {
    global query = HalForms.getProperty("searchInput", "text")
    if query == "" {
        refreshContactList()
        return
    }
    
    query = query.toLowerCase()
    HalForms.clearItems("contactList")
    
    for i from 0 to len(contactNames) - 1 {
        global name = contactNames[i].toLowerCase()
        global phone = contactPhones[i].toLowerCase()
        global email = contactEmails[i].toLowerCase()
        
        if name.contains(query) or phone.contains(query) or email.contains(query) {
            HalForms.addItem("contactList", contactNames[i])
        }
    }
    
    HalForms.setStatusBarText("statusBar", 0, "Search results for: " + query)
}

# Function to export contacts
func exportContacts() {
    if len(contactNames) == 0 {
        HalForms.messageBox("No contacts to export!", "Info", 0, 0)
        return
    }
    
    global path = HalForms.saveFile("Export Contacts", "CSV Files (*.csv)|*.csv", "contacts.csv")
    if path != "" {
        global content = "Name,Phone,Email,Address,Notes\n"
        for i from 0 to len(contactNames) - 1 {
            content = content + contactNames[i] + ","
            content = content + contactPhones[i] + ","
            content = content + contactEmails[i] + ","
            content = content + contactAddresses[i] + ","
            content = content + contactNotes[i] + "\n"
        }
        
        global success = File.write(path, content)
        if success {
            HalForms.messageBox("Contacts exported successfully!", "Success", 0, 0)
        } else {
            HalForms.messageBox("Failed to export contacts!", "Error", 0, 0)
        }
    }
}

# Event handlers
on newBtn clicked {
    clearForm()
    HalForms.setStatusBarText("statusBar", 0, "New contact")
}

on saveBtn clicked {
    saveContact()
}

on deleteBtn clicked {
    deleteContact()
}

on searchBtn clicked {
    searchContacts()
}

on clearSearchBtn clicked {
    HalForms.setProperty("searchInput", "text", "")
    refreshContactList()
}

on exportBtn clicked {
    exportContacts()
}

on contactList clicked {
    global selectedIdx = HalForms.getProperty("contactList", "selectedIndex")
    if selectedIdx >= 0 {
        loadContact(selectedIdx)
    }
}

# Add some sample contacts
contactNames.push("John Smith")
contactPhones.push("+1 555-1234")
contactEmails.push("john@example.com")
contactAddresses.push("123 Main St")
contactNotes.push("Friend from work")

contactNames.push("Jane Doe")
contactPhones.push("+1 555-5678")
contactEmails.push("jane@example.com")
contactAddresses.push("456 Oak Ave")
contactNotes.push("College friend")

contactNames.push("Bob Wilson")
contactPhones.push("+1 555-9012")
contactEmails.push("bob@example.com")
contactAddresses.push("789 Pine Rd")
contactNotes.push("Neighbor")

refreshContactList()

print "Contacts Manager ready!"
HalForms.run()
