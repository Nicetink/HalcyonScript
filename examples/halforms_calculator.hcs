# HalForms Calculator - A working calculator application
# Uses HalForms Windows Forms-like API

print "Starting Calculator..."

# Initialize HalForms
HalForms.init()

# Create main form
HalForms.createForm("mainForm", "Calculator", 320, 450, 0)

# Display
HalForms.createControl("textbox", "display", "0", 10, 10, 295, 40)
HalForms.setProperty("display", "readonly", true)

# Variables for calculator state
global currentValue = "0"
global previousValue = ""
global operation = ""
global newNumber = true

# Function to update display
func updateDisplay() {
    HalForms.setProperty("display", "text", currentValue)
}

# Function to handle number input
func inputNumber(num) {
    if newNumber {
        currentValue = num
        newNumber = false
    } else {
        if currentValue == "0" {
            currentValue = num
        } else {
            currentValue = currentValue + num
        }
    }
    updateDisplay()
}

# Function to handle operation
func setOperation(op) {
    previousValue = currentValue
    operation = op
    newNumber = true
}

# Function to calculate result
func calculate() {
    if previousValue == "" {
        return
    }
    
    global prev = float(previousValue)
    global curr = float(currentValue)
    global result = 0
    
    if operation == "+" {
        result = prev + curr
    }
    if operation == "-" {
        result = prev - curr
    }
    if operation == "*" {
        result = prev * curr
    }
    if operation == "/" {
        if curr != 0 {
            result = prev / curr
        } else {
            HalForms.messageBox("Cannot divide by zero!", "Error", 0, 0)
            return
        }
    }
    
    currentValue = str(result)
    previousValue = ""
    operation = ""
    newNumber = true
    updateDisplay()
}

# Function to clear
func clearAll() {
    currentValue = "0"
    previousValue = ""
    operation = ""
    newNumber = true
    updateDisplay()
}

# Create number buttons (row by row)
# Row 1: 7, 8, 9, /
HalForms.createControl("button", "btn7", "7", 10, 70, 65, 50)
HalForms.createControl("button", "btn8", "8", 85, 70, 65, 50)
HalForms.createControl("button", "btn9", "9", 160, 70, 65, 50)
HalForms.createControl("button", "btnDiv", "/", 235, 70, 65, 50)

# Row 2: 4, 5, 6, *
HalForms.createControl("button", "btn4", "4", 10, 130, 65, 50)
HalForms.createControl("button", "btn5", "5", 85, 130, 65, 50)
HalForms.createControl("button", "btn6", "6", 160, 130, 65, 50)
HalForms.createControl("button", "btnMul", "*", 235, 130, 65, 50)

# Row 3: 1, 2, 3, -
HalForms.createControl("button", "btn1", "1", 10, 190, 65, 50)
HalForms.createControl("button", "btn2", "2", 85, 190, 65, 50)
HalForms.createControl("button", "btn3", "3", 160, 190, 65, 50)
HalForms.createControl("button", "btnSub", "-", 235, 190, 65, 50)

# Row 4: 0, ., =, +
HalForms.createControl("button", "btn0", "0", 10, 250, 65, 50)
HalForms.createControl("button", "btnDot", ".", 85, 250, 65, 50)
HalForms.createControl("button", "btnEq", "=", 160, 250, 65, 50)
HalForms.createControl("button", "btnAdd", "+", 235, 250, 65, 50)

# Row 5: C, +/-, sqrt, %
HalForms.createControl("button", "btnC", "C", 10, 310, 65, 50)
HalForms.createControl("button", "btnNeg", "+/-", 85, 310, 65, 50)
HalForms.createControl("button", "btnSqrt", "sqrt", 160, 310, 65, 50)
HalForms.createControl("button", "btnPct", "%", 235, 310, 65, 50)

# Row 6: CE, Backspace
HalForms.createControl("button", "btnCE", "CE", 10, 370, 140, 50)
HalForms.createControl("button", "btnBack", "Backspace", 160, 370, 140, 50)

# Event handlers for number buttons
on btn0 clicked {
    inputNumber("0")
}

on btn1 clicked {
    inputNumber("1")
}

on btn2 clicked {
    inputNumber("2")
}

on btn3 clicked {
    inputNumber("3")
}

on btn4 clicked {
    inputNumber("4")
}

on btn5 clicked {
    inputNumber("5")
}

on btn6 clicked {
    inputNumber("6")
}

on btn7 clicked {
    inputNumber("7")
}

on btn8 clicked {
    inputNumber("8")
}

on btn9 clicked {
    inputNumber("9")
}

on btnDot clicked {
    if newNumber {
        currentValue = "0."
        newNumber = false
    } else {
        # Check if already has decimal point
        global hasDecimal = false
        for i from 0 to len(currentValue) - 1 {
            if currentValue[i] == "." {
                hasDecimal = true
            }
        }
        if not hasDecimal {
            currentValue = currentValue + "."
        }
    }
    updateDisplay()
}

# Event handlers for operations
on btnAdd clicked {
    setOperation("+")
}

on btnSub clicked {
    setOperation("-")
}

on btnMul clicked {
    setOperation("*")
}

on btnDiv clicked {
    setOperation("/")
}

on btnEq clicked {
    calculate()
}

# Clear and special functions
on btnC clicked {
    clearAll()
}

on btnCE clicked {
    currentValue = "0"
    newNumber = true
    updateDisplay()
}

on btnBack clicked {
    if len(currentValue) > 1 {
        currentValue = currentValue.substring(0, len(currentValue) - 1)
    } else {
        currentValue = "0"
    }
    updateDisplay()
}

on btnNeg clicked {
    global val = float(currentValue)
    val = val * -1
    currentValue = str(val)
    updateDisplay()
}

on btnSqrt clicked {
    global val = float(currentValue)
    if val >= 0 {
        val = sqrt(val)
        currentValue = str(val)
        updateDisplay()
    } else {
        HalForms.messageBox("Cannot calculate square root of negative number!", "Error", 0, 0)
    }
}

on btnPct clicked {
    global val = float(currentValue)
    val = val / 100
    currentValue = str(val)
    updateDisplay()
}

print "Calculator ready!"
HalForms.run()
