// HalcyonScript Application Resource File
// This embeds the default icon into compiled applications

#include <windows.h>

// Application icon - HalcyonScript default logo
// IDI_APPICON = 1 is the standard Windows icon resource ID
1 ICON "..\\logo\\halcyon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KAInaps"
            VALUE "FileDescription", "HalcyonScript Application"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "halcyon"
            VALUE "LegalCopyright", "Copyright (C) 2025 KAInaps"
            VALUE "OriginalFilename", "halcyon.exe"
            VALUE "ProductName", "HalcyonScript"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
